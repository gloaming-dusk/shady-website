---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import HourVideo from '../components/HourVideo.astro';
import horizonShot from '@shady/rices/horizon/preview.jpg';
import objectsShot from '@shady/rices/objects/preview.jpg';
import afterglowShot from '@shady/rices/afterglow/preview.jpg';
import neonShot from '@shady/rices/neon-transit/preview.jpg';

const repo = 'https://github.com/gloaming-dusk/shady';

const metrics = [
  ['wlroots 0.20.2', 'Wayland core'],
  ['GLES2', 'Spatial renderer'],
  ['C ABI v2', 'Hot-reload plugins'],
  ['Lua 5.4', 'Config + runtime']
];

const features = [
  {
    kicker: 'Render',
    title: 'A real perspective world',
    body: 'xdg-shell clients become lit 3D panes with rounded glass frames, depth, wobble and shadows. Drawing, picking and collision share one geometry.',
    icon: '<path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>'
  },
  {
    kicker: 'Extend',
    title: 'Hot-reloadable C plugins',
    body: 'Window representations, render hooks with the live camera, input and per-window shaders. ABI v2 migrates state across reloads.',
    icon: '<path d="M9 3v4M15 3v4M7 7h10v4a5 5 0 0 1-10 0V7ZM12 16v5"/>'
  },
  {
    kicker: 'Script',
    title: 'Lua, twice',
    body: 'config.lua shapes the compositor before modules resolve; init.lua reacts to windows, workspaces and keys at runtime.',
    icon: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>'
  },
  {
    kicker: 'Verify',
    title: 'Headless, sanitized tests',
    body: 'Drive input, timers and screenshots from Lua against a headless GLES2 backend, under AddressSanitizer and UBSan.',
    icon: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/>'
  },
  {
    kicker: 'Fallback',
    title: 'A safe scene-graph path',
    body: '--safe drops the spatial renderer for a conventional wlroots scene graph, so a broken experiment never locks you out.',
    icon: '<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>'
  },
  {
    kicker: 'Layers',
    title: 'Panels in the 3D world',
    body: 'Any layer-shell client, shady-shell or waybar alike, can be frosted, blurred or turned in perspective, and pointer input still lands where it is drawn.',
    icon: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>'
  }
];

const programs = [
  {
    name: 'shady',
    role: 'The compositor',
    body: 'Owns the Wayland objects, the GPU, input and the 3D world. Turns xdg-shell windows into lit objects, or runs a plain scene graph with --safe.',
    points: [
      'Perspective GLES2 renderer, physics and first-person mode',
      'Hot-reloadable C plugins with an ABI v2 state migration',
      'config.lua + init.lua, an IPC socket and shadyctl',
      'Headless automation under ASan and UBSan'
    ],
    docs: '/docs/lua-api/',
    docsLabel: 'Lua API'
  },
  {
    name: 'shady-shell',
    role: 'The desktop shell',
    body: 'A separate Wayland client that draws the desktop around the windows. Everything it shows is a Lua widget tree, and saving the file reloads it in place.',
    points: [
      'Bars, docks, launchers and control centers, one per output, HiDPI',
      'A notification server, wrapped text and input-method typing',
      'GLSL shaders over any widget, native shell plugins',
      'Background and bottom layers for wallpapers and clocks'
    ],
    docs: '/docs/shell-lua-api/',
    docsLabel: 'Shell Lua API'
  }
];

const luaSnippet = `-- config.lua — shape the compositor
shady.set("window_corner_radius", 14.0)
shady.set("window_border_focus_color", "#FFB070")
shady.set("floor_horizon_fog", 1.0)
shady.plugin("build/libshady-plugin-afterglow.so")

-- init.lua — react to the desktop
shady.bind("Super+Return", function()
    shady.spawn("foot")
end)

shady.on("window.mapped", function(window)
    shady.log("arrived: " .. window.app_id)
end)`;

const cSnippet = `/* A sky that knows where the camera is. */
static void draw(shady_host host,
        const struct shady_render_context *ctx, void *data) {
    if (!SHADY_RENDER_CONTEXT_HAS(ctx, aspect)) return;
    api->shader_uniform_vec4(host, sky, "u_cam_fwd",
        ctx->camera_forward[0], ctx->camera_forward[1],
        ctx->camera_forward[2], 0.f);
    api->shader_uniform_float(host, sky, "u_time",
        ctx->time_seconds);
    api->shader_draw_fullscreen(host, sky);
}

hook = api->render_hook_add(host,
    SHADY_RENDER_STAGE_AFTER_BACKGROUND, draw, NULL);`;
---
<BaseLayout path="/">
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Wayland, with depth</p>
      <h1>A compositor for <span class="gradient-text">spatial desktops.</span></h1>
      <p class="lede">
        Shady turns ordinary Wayland windows into objects in a shared 3D world, and
        shady-shell draws the desktop around them — with a conventional scene-graph
        path for the days you just need to work.
      </p>
      <div class="button-row">
        <a class="button primary" href="/getting-started/">Build Shady</a>
        <a class="button" href="/demo/afterglow/">Watch Afterglow</a>
        <a class="button" href="/docs/">Read the docs</a>
      </div>

      <div class="stage">
        <HourVideo />
      </div>

      <div class="metrics">
        {metrics.map(([value, label]) => (
          <div class="metric"><strong>{value}</strong><span>{label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="shell">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow">Two programs</p>
          <h2>A compositor and its shell.</h2>
        </div>
        <p>
          The compositor and the shell are separate processes that talk over the
          shady-shell protocol, so either can be swapped: run shady-shell's bar,
          or waybar, or nothing at all.
        </p>
      </div>
      <div class="programs">
        {programs.map((program) => (
          <article class="card program">
            <p class="program-role">{program.role}</p>
            <h3><code>{program.name}</code></h3>
            <p>{program.body}</p>
            <ul>
              {program.points.map((point) => <li>{point}</li>)}
            </ul>
            <a class="program-link" href={program.docs}>{program.docsLabel} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow">What's inside</p>
          <h2>Experiments, with boundaries.</h2>
        </div>
        <p>
          The compositor owns Wayland objects, GPU resources, lifetime and
          validation. Plugins and scripts own the effects, layouts and
          simulations layered on top, and can be swapped while it runs.
        </p>
      </div>
      <div class="card-grid">
        {features.map((feature) => (
          <article class="card">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={feature.icon} />
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow">Rices</p>
          <h2>One compositor, different evenings.</h2>
        </div>
        <p>
          A rice is a compositor config, a Lua runtime layer, a shell.lua and a
          few native plugins. Four ship with Shady; each runs nested or straight
          from a VT, and Horizon is the default.
        </p>
      </div>
      <div class="rices">
        <a class="rice horizon" href={`${repo}/tree/main/rices/horizon`}>
          <img src={horizonShot.src} width={horizonShot.width} height={horizonShot.height} loading="lazy" alt="Horizon: the time written across a sunset sky, a workspace light on the horizon and a frosted control center turned in 3D" />
          <div class="rice-body">
            <h3><span class="pip"></span>Horizon <span class="tag">default</span></h3>
            <p>shady-shell living in Afterglow's sky. The time is written across it, workspaces are lights on the horizon, notifications are words in the sky, and the launcher scatters applications as stars.</p>
            <span class="rice-meta">no bar · 3D glass control center · constellation launcher · on GitHub ↗</span>
          </div>
        </a>
        <a class="rice objects" href={`${repo}/tree/main/rices/objects`}>
          <img src={objectsShot.src} width={objectsShot.width} height={objectsShot.height} loading="lazy" alt="Objects: a two-tile desk clock and a floating dock on a paper sunset, around a terminal framed as a card" />
          <div class="rice-body">
            <h3><span class="pip"></span>Objects</h3>
            <p>Chunky, tactile cards on a flat paper sunset: a desk clock, a floating dock, a control center that leans like a remote and a launcher that fans out like a hand of cards.</p>
            <span class="rice-meta">ink outlines · sticker notifications · card-deck launcher · on GitHub ↗</span>
          </div>
        </a>
        <a class="rice" href="/demo/afterglow/">
          <img src={afterglowShot.src} width={afterglowShot.width} height={afterglowShot.height} loading="lazy" alt="Afterglow: rounded glass windows above a sunset sea with a glitter path" />
          <div class="rice-body">
            <h3><span class="pip"></span>Afterglow</h3>
            <p>A low sun over a mirror-still sea. The sky, the water, every accent and the shell move through four hours of light on <kbd>Super</kbd>+<kbd>T</kbd>.</p>
            <span class="rice-meta">afterglow plugin · camera-aware sky · sinking close</span>
          </div>
        </a>
        <a class="rice neon" href={`${repo}/tree/main/rices/neon-transit`}>
          <img src={neonShot.src} width={neonShot.width} height={neonShot.height} loading="lazy" alt="Neon Transit: cyan-rimmed windows with liquid water surfaces over a neon grid" />
          <div class="rice-body">
            <h3><span class="pip"></span>Neon Transit</h3>
            <p>Night trains and terminal glow: a cyan grid floor, liquid water-surface windows and a native 3D overview.</p>
            <span class="rice-meta">water-windows · spatial-overview · on GitHub ↗</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow">Make it yours</p>
          <h2>Configure in Lua. Extend in C.</h2>
        </div>
        <p>
          Everything above is built from these two layers. The same Lua runtime
          drives the headless test suite, and plugins never touch raw GL state.
        </p>
      </div>
      <div class="code-grid">
        <div class="code-window">
          <div class="code-title">config.lua + init.lua</div>
          <Code code={luaSnippet} lang="lua" theme="github-dark-default" />
        </div>
        <div class="code-window">
          <div class="code-title">plugins/afterglow.c</div>
          <Code code={cSnippet} lang="c" theme="github-dark-default" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="cta">
        <div>
          <p class="eyebrow">Fast path</p>
          <h2>From checkout to a nested compositor.</h2>
          <p>
            The Nix shell pins wlroots and the whole toolchain. Start nested inside
            your current session, then move to a real VT once the basics are solid.
          </p>
          <div class="button-row">
            <a class="button primary" href="/getting-started/">Getting started</a>
            <a class="button" href={repo}>View source</a>
          </div>
        </div>
        <div class="code-window">
          <div class="code-title">terminal</div>
          <pre><code>nix develop
./tools/build.sh

# nested, with the default Horizon rice
./rices/horizon/run.sh</code></pre>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
